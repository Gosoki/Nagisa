{
  "name": "@nagisa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nagisa realtime server: rooms, activities, presence and the authoritative world state.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
